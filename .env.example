# Frontend Environment Variables (set these in Vercel dashboard)

# Backend API URL (your Railway deployed backend)
VITE_API_URL=https://your-backend.up.railway.app

# ElevenLabs Voice API
VITE_ELEVENLABS_API_KEY=your_elevenlabs_key
VITE_USE_ELEVENLABS=true
VITE_ELEVENLABS_MODEL=eleven_monolingual_v1
VITE_ELEVENLABS_AGENT_ID=your_agent_id

# Voice Features
VITE_VOICE_PRACTICE_ENABLED=true
VITE_VOICE_API_PROVIDER=elevenlabs

# Firebase (client-side - these are safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# OpenAI (if used on frontend)
VITE_OPENAI_API_KEY=your_openai_key
